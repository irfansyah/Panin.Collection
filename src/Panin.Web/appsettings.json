{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Components.Server.Circuits": "Warning",
        "System": "Warning",
        "Panin.Web.Infrastructure.Logging.CircuitCorrelationHandler": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Ref} {UserId} {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/panin-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Session": {
    "HeartbeatSeconds": 60,
    "AbandonedAfterSeconds": 180,
    "IdleWarningMinutes": 20,
    "IdleLogoutAfterWarningMinutes": 5
  },
  "Menu": {
    "LegacyUrlMap": {
      "~/controls/search_debitur.aspx": "/collection/inquiry/debitur",
      "~/main/mainfacility.aspx?func=accmon": "/collection/monitoring/debitur",
      "~/main/mainfacility.aspx?func=worklistmonitoring": "/collection/worklist",
      "~/controls/search_activity_collector.aspx": "/collection/monitoring/aktivitas",
      "~/facilities/bulksurat.aspx": "/collection/bulk-surat",
      "~/parameter/paramset.aspx?set=user&ismaker=1&title=user and group parameter maker&moduleid=99": "/maintenance/params/maker",
      "~/parameter/paramset.aspx?set=user&ismaker=0&title=user and group parameter approval&moduleid=99": "/maintenance/params/approval",
      "~/parameter/paramset.aspx?set=gen&ismaker=1&title=collection general parameter maker&moduleid=60": "/maintenance/params/gen/maker",
      "~/parameter/paramset.aspx?set=gen&ismaker=0&title=collection general parameter approval&moduleid=60": "/maintenance/params/gen/approval",
      "~/parameter/paramset.aspx?set=proc&ismaker=1&title=collection process parameter maker&moduleid=60": "/maintenance/params/proc/maker",
      "~/parameter/paramset.aspx?set=proc&ismaker=0&title=collection process parameter approval&moduleid=60": "/maintenance/params/proc/approval"
    }
  },
  "Letters": {
    "TemplateDirectory": "Templates",
    "OutputDirectory": "App_Data/surat",
    "ProtectionPassword": "rahasia"
  },
  "ParallelRun": {
    "Enabled": false,
    "OldAppUrl": ""
  },
  "Diagnostics": {
    "Enabled": false
  },
  "DataAccess": {
    "ReadOnlyProcedures": [
      "SP_VW_WARNINGCONTENT",
      "USP_VWDELINQHIST",
      "SP_JOB_INFO",
      "SP_SPOUSE_INFO",
      "SP_SPOUSE_JOB",
      "SP_GET_CONTACT_INFO",
      "SP_ACCOUNT_MONITORING_DEBITUR",
      "SP_GET_TARGET_ACHIEVMENT",
      "SP_GET_OS",
      "SP_GET_REASON",
      "SP_GET_ACTION",
      "SP_PTP_CHANGELIST",
      "SP_GET_CONTACT",
      "GET_RELATIONSHIP_TYPE",
      "GET_PAYMENT_TYPE",
      "SP_TREATMENTRESULT_MAXDAY",
      "SP_GET_TREATMENT_MENU",
      "SP_GET_RESULT",
      "SP_GET_FIELD_OFFICER",
      "SP_GET_CITY",
      "SP_SURAT_TYPE",
      "SP_ACTIVITY_SEARCH",
      "SP_LIST_BULK_GENERATE",
      "SP_LIST_SURAT_UNCONFIRMED",
      "SP_GET_DOWNLINE"
    ]
  }
}
