{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Session": {
    "HeartbeatSeconds": 60,
    "AbandonedAfterSeconds": 180,
    "IdleWarningMinutes": 20,
    "IdleLogoutAfterWarningMinutes": 5
  },
  "Menu": {
    "LegacyUrlMap": {
      "~/controls/search_debitur.aspx": "/collection/inquiry/debitur"
    }
  },
  "Diagnostics": {
    "Enabled": false
  },
  "DataAccess": {
    "ReadOnlyProcedures": [
      "SP_VW_WARNINGCONTENT",
      "USP_VWDELINQHIST",
      "SP_JOB_INFO",
      "SP_SPOUSE_INFO",
      "SP_SPOUSE_JOB",
      "SP_GET_CONTACT_INFO"
    ]
  }
}
