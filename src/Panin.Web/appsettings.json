{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Session": {
    "HeartbeatSeconds": 60,
    "AbandonedAfterSeconds": 180,
    "IdleWarningMinutes": 20,
    "IdleLogoutAfterWarningMinutes": 5
  },
  "Menu": {
    "LegacyUrlMap": {}
  },
  "Diagnostics": {
    "Enabled": false
  }
}
