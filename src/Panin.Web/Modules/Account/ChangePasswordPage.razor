@attribute [ModulePage("60", "/account/password")]
@attribute [ModulePage("70", "/account/password")]
@attribute [ModulePage("99", "/account/password")]
@using Microsoft.Extensions.Options
@using Panin.Application.Auth
@using Panin.Web.Components.Common
@inject IAuthService Auth
@inject IOptions<Panin.Application.Maintenance.ParallelRunOptions> Parallel
@inject ILogger<ChangePasswordPage> Logger

<section class="mx-auto max-w-md space-y-4">
    <h1 class="text-xl font-semibold text-slate-800">Ganti Password</h1>

    @if (Parallel.Value.Enabled)
    {
        <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="note">
            @Parallel.Value.PasswordMessage
        </div>
    }
    else
    {
        <form @onsubmit="SubmitAsync" class="space-y-4 rounded-lg border border-slate-200 bg-white p-4">
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="@(_success ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700") rounded-md border px-3 py-2 text-sm" role="@(_success ? "status" : "alert")">@_message</div>
            }

            <Field Label="Password lama" Required="true">
                <input id="old" type="password" @bind="_old" @bind:event="oninput" autocomplete="current-password" maxlength="128" class="@InputClass" />
            </Field>
            <Field Label="Password baru" Required="true">
                <input id="new" type="password" @bind="_new" @bind:event="oninput" autocomplete="new-password" maxlength="128" class="@InputClass" />
            </Field>
            <Field Label="Ulangi password baru" Required="true">
                <input id="verify" type="password" @bind="_verify" @bind:event="oninput" autocomplete="new-password" maxlength="128" class="@InputClass" />
            </Field>

            <button type="submit" disabled="@_busy" class="w-full rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white enabled:hover:bg-sky-800 disabled:opacity-60">Simpan</button>
        </form>
    }
</section>

@code {
    private const string InputClass = "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500";

    private string? _old, _new, _verify, _message, _userId;
    private bool _busy, _success;

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
        => _userId = (await AuthState).User.ToSessionUser()?.UserId;

    private async Task SubmitAsync()
    {
        if (_busy || _userId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_old) || string.IsNullOrWhiteSpace(_new) || string.IsNullOrWhiteSpace(_verify))
        {
            (_success, _message) = (false, "Semua isian wajib diisi.");
            return;
        }

        _busy = true;
        try
        {
            // Kepemilikan akun diambil dari sesi, bukan dari masukan: pengguna hanya dapat mengganti password miliknya sendiri.
            var outcome = await Auth.ChangePasswordAsync(_userId, _old, _new, _verify);
            _success = outcome.Result == PasswordChangeResult.Changed;
            _message = _success
                ? "Password berhasil diganti."
                : outcome.Message ?? "Password tidak dapat diganti. Coba lagi atau hubungi administrator.";
            if (_success)
            {
                Logger.LogInformation("Password diganti oleh pengguna {UserId}", _userId);
                (_old, _new, _verify) = (null, null, null);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ganti password gagal untuk {UserId}", _userId);
            (_success, _message) = (false, $"Password tidak dapat diganti. Hubungi administrator. {ErrorReference.Tag}");
        }
        finally
        {
            _busy = false;
        }
    }
}
