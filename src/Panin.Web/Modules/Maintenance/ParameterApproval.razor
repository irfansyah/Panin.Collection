@attribute [ModulePage("99", "/maintenance/parameter/approval")]
@implements IDisposable
@using Panin.Application.Collection
@using Panin.Application.Maintenance
@using Panin.Web.Components.Common
@inject IParameterService Parameters
@inject ILogger<ParameterApproval> Logger

<section class="space-y-4">
    <div class="flex items-center justify-between gap-3">
        <h1 class="text-xl font-semibold text-slate-800">@Title <span class="text-base font-normal text-slate-500">· Approval</span></h1>
        <div class="flex gap-2">
            @if (_table is not null)
            {
                <button type="button" @onclick="RefreshAsync" disabled="@_busy" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 enabled:hover:bg-slate-100 disabled:opacity-60">Muat ulang</button>
            }
            @if (Navigator is { CanGoBack: true })
            {
                <button type="button" @onclick="Navigator.Back" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100">← Kembali</button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <p class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-500" role="status">Memuat...</p>
    }
    else if (!_allowed)
    {
        <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert">Group Anda tidak punya hak Approval untuk parameter ini.</div>
    }
    else if (_table is null)
    {
        <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert">Parameter ini tidak terdaftar atau tidak dapat dikelola dari sini.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700" role="status">@_message</div>
        }

        @if (_errors.Count > 0)
        {
            <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
                <ul class="list-disc pl-5">
                    @foreach (var e in _errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <Card Title="Menunggu persetujuan">
            <div class="mb-3 flex flex-wrap items-center gap-2 text-sm">
                <button type="button" @onclick="() => DecideAsync(true)" disabled="@(_busy || _selected.Count == 0)"
                        class="rounded-md bg-sky-700 px-3 py-1.5 font-medium text-white enabled:hover:bg-sky-800 disabled:opacity-60">Setujui terpilih</button>
                <button type="button" @onclick="() => DecideAsync(false)" disabled="@(_busy || _selected.Count == 0)"
                        class="rounded-md border border-red-300 bg-white px-3 py-1.5 font-medium text-red-700 enabled:hover:bg-red-50 disabled:opacity-60">Tolak terpilih</button>
                <button type="button" @onclick="SelectAll" class="rounded border border-slate-300 px-2 py-1 text-xs hover:bg-slate-100">Pilih semua</button>
                <button type="button" @onclick="() => _selected.Clear()" class="rounded border border-slate-300 px-2 py-1 text-xs hover:bg-slate-100">Kosongkan</button>
                <span class="text-slate-600">@_selected.Count dipilih</span>
            </div>
            <DataGrid TItem="PendingParameterRow" Items="_pending" Columns="_columns" EmptyText="Tidak ada ajuan." />
        </Card>
    }
</section>

@code {
    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<Guid> _selected = [];
    private readonly Dictionary<string, IReadOnlyList<LookupItem>> _lookups = new(StringComparer.OrdinalIgnoreCase);
    private ParameterTable? _table;
    private IReadOnlyList<PendingParameterRow> _pending = [];
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<GridColumn<PendingParameterRow>> _columns = [];
    private ParameterActor? _actor;
    private string? _message;
    private bool _loading = true, _allowed, _busy;

    [Parameter, EditorRequired] public string SetId { get; set; } = "GEN";

    [Parameter, EditorRequired] public string ModuleId { get; set; } = "60";

    [Parameter, EditorRequired] public string Table { get; set; } = string.Empty;

    [Parameter] public string Title { get; set; } = string.Empty;

    [CascadingParameter] private IModuleNavigator? Navigator { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthState).User.ToSessionUser();
            if (user is null)
            {
                return;
            }

            _actor = new ParameterActor(user.UserId, user.GroupId);
            _allowed = await Parameters.HasRoleAsync(user.GroupId, MaintenanceRole.Approver, SetId, _cts.Token);
            if (!_allowed)
            {
                return;
            }

            _table = await Parameters.GetTableAsync(SetId, ModuleId, Table, _cts.Token);
            if (_table is null)
            {
                return;
            }

            foreach (var f in _table.Fields.Where(f => f.LookupSql is not null))
            {
                _lookups[f.Name] = await Parameters.GetLookupAsync(_table, f.Name, _cts.Token);
            }

            BuildColumns();
            _pending = await Parameters.GetPendingAsync(_table, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Halaman approval parameter {Table} gagal dimuat", Table);
            _errors = [$"Halaman gagal dimuat. Coba lagi atau hubungi administrator. {ErrorReference.Tag}"];
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildColumns()
    {
        string? Show(ParameterField f, string? v) => f.Kind == ParameterKind.Boolean ? (v == "1" ? "Ya" : v == "0" ? "Tidak" : v)
            : f.LookupSql is not null && v is not null ? _lookups.GetValueOrDefault(f.Name)?.FirstOrDefault(i => i.Code == v)?.Text ?? v : v;

        var cols = new List<GridColumn<PendingParameterRow>>
        {
            new() { Header = "", Value = p => p.TemporaryId, ActionOnly = true, Sortable = false, Template = p => @<input type="checkbox" checked="@_selected.Contains(p.TemporaryId)" @onchange="e => Toggle(p.TemporaryId, e)" aria-label="@($"Pilih ajuan {p.Status}")" /> },
            new() { Header = "Status", Value = p => p.Status },
            new() { Header = "Diajukan oleh", Value = p => p.CreatedBy },
            new() { Header = "Perubahan", Value = p => p.Changes },
        };
        cols.AddRange(_table!.Fields.Where(f => f.Kind != ParameterKind.Unsupported)
            .Select(f => new GridColumn<PendingParameterRow> { Header = f.Label, Value = p => p.Get(f.Name), Display = p => Show(f, p.Get(f.Name)) }));
        _columns = cols;
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            _selected.Clear();
            _pending = await Parameters.GetPendingAsync(_table!, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Muat ulang approval parameter {Table} gagal", Table);
            _errors = [$"Data gagal dimuat. Coba lagi atau hubungi administrator. {ErrorReference.Tag}"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void Toggle(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private void SelectAll()
    {
        foreach (var p in _pending)
        {
            _selected.Add(p.TemporaryId);
        }
    }

    private async Task DecideAsync(bool approve)
    {
        if (_busy || _actor is null || _table is null || _selected.Count == 0)
        {
            return;
        }

        _busy = true;
        _message = null;
        _errors = [];
        try
        {
            var ids = _selected.ToList();
            var result = approve ? await Parameters.ApproveAsync(_actor, _table, ids, _cts.Token) : await Parameters.RejectAsync(_actor, _table, ids, _cts.Token);
            _errors = result.Errors;
            if (result.Success)
            {
                _message = approve ? $"{ids.Count} ajuan disetujui." : $"{ids.Count} ajuan ditolak.";
            }

            _selected.Clear();
            _pending = await Parameters.GetPendingAsync(_table, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Keputusan approval parameter {Table} gagal", Table);
            _errors = [$"Aksi gagal. Coba lagi atau hubungi administrator. {ErrorReference.Tag}"];
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
