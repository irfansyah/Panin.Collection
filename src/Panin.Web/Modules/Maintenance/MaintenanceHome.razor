@attribute [ModulePage("99", "/maintenance")]
@implements IDisposable
@using System.Globalization
@using Panin.Application.Maintenance
@using Panin.Web.Components.Dashboard
@using Panin.Web.Components.Shell
@inject IMaintenanceDashboardService Dashboard
@inject ILogger<MaintenanceHome> Logger

<section class="space-y-6">
    <DashHero Title="@Greeting" Subtitle="@($"Pusat persetujuan, {Today.ToString("dddd, d MMMM yyyy", Indonesian)}")">
        <Chips>
            @if (_pending is { IsCompletedSuccessfully: true })
            {
                var others = _pending.Result.Total - _pending.Result.Mine;
                <HeroChip Tone="@(others > 0 ? "bad" : "ok")">@(others > 0 ? $"{others} menunggu persetujuan Anda" : "Tidak ada ajuan menunggu")</HeroChip>
                @if (_pending.Result.Mine > 0)
                {
                    <HeroChip Tone="warn">@_pending.Result.Mine ajuan Anda menunggu orang lain</HeroChip>
                }
            }
            @if (_users is { IsCompletedSuccessfully: true } && _users.Result.Revoked > 0)
            {
                <HeroChip Tone="warn">@_users.Result.Revoked user terkunci</HeroChip>
            }
        </Chips>
        <Actions>
            <button type="button" @onclick="() => Open<UserApproval>()" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3.5 py-2 text-sm font-semibold text-sky-800 shadow-sm hover:bg-sky-50"><Icon Name="shield" Class="size-4 shrink-0" /> Persetujuan user</button>
            <button type="button" @onclick="() => Open<UserMaker>()" class="inline-flex items-center gap-1.5 rounded-lg bg-white/15 px-3.5 py-2 text-sm font-semibold text-white ring-1 ring-inset ring-white/25 hover:bg-white/25"><Icon Name="users" Class="size-4 shrink-0" /> Ajukan user</button>
        </Actions>
    </DashHero>

    <div>
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Ringkasan</h2>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            @{
                var pendingReady = _pending is { IsCompletedSuccessfully: true };
                var usersReady = _users is { IsCompletedSuccessfully: true };
                var waiting = pendingReady ? _pending!.Result.Total - _pending.Result.Mine : 0;
            }
            <DashStat IconName="shield" Tone="@(pendingReady && waiting > 0 ? "bad" : "ok")" Label="Menunggu persetujuan Anda" Value="@(pendingReady ? Number(waiting) : "…")" Hint="Ajuan orang lain" />
            <DashStat IconName="clipboard-list" Tone="@(pendingReady && _pending!.Result.Mine > 0 ? "warn" : "info")" Label="Ajuan Anda menunggu" Value="@(pendingReady ? Number(_pending!.Result.Mine) : "…")" Hint="Perlu disetujui orang lain" />
            <DashStat IconName="users" Label="User aktif" Value="@(usersReady ? Number(_users!.Result.Active) : "…")" Hint="@(usersReady ? $"dari {Number(_users!.Result.Total)} terdaftar" : null)" />
            <DashStat IconName="lock" Tone="@(usersReady && _users!.Result.Revoked > 0 ? "warn" : "ok")" Label="User terkunci" Value="@(usersReady ? Number(_users!.Result.Revoked) : "…")" Hint="@(usersReady ? $"{Number(_users!.Result.LoggedOn)} sedang login" : null)" />
        </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <Widget T="PendingSummary" Title="Antrian persetujuan" Subtitle="Urut dari yang tertua; maker dan approver harus orang berbeda" Load="LoadPending">
                <ChildContent Context="p">
                    @if (p.Oldest.Count == 0)
                    {
                        <div class="flex flex-col items-center py-8 text-center">
                            <span class="grid size-12 place-items-center rounded-full bg-emerald-50 text-emerald-600"><Icon Name="check-circle" Class="size-6" /></span>
                            <p class="mt-3 text-sm text-slate-500">Tidak ada ajuan yang menunggu persetujuan.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="text-[11px] uppercase tracking-wide text-slate-500">
                                    <tr><th class="px-2 py-2 font-semibold">Jenis</th><th class="px-2 py-2 font-semibold">Perubahan</th><th class="px-2 py-2 font-semibold">Maker</th><th class="px-2 py-2 font-semibold">Umur</th><th class="px-2 py-2"></th></tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var item in p.Oldest)
                                    {
                                        <tr @key="item.TemporaryId">
                                            <td class="px-2 py-2"><span class="rounded-md bg-sky-50 px-2 py-0.5 text-xs font-semibold text-sky-700">@ChangeKinds.Label(item.Kind)</span></td>
                                            <td class="px-2 py-2"><b class="font-semibold text-slate-800">@Describe(item)</b></td>
                                            <td class="px-2 py-2 text-slate-600">@item.CreatedBy</td>
                                            <td class="px-2 py-2"><span class="@("rounded-md px-2 py-0.5 text-xs font-semibold " + AgeTone(item))">@ChangeKinds.Age(item.CreatedDate, Now)</span></td>
                                            <td class="px-2 py-2 text-right"><button type="button" @onclick="() => Review(item.Kind)" class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50">Tinjau</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (p.Total > p.Oldest.Count)
                        {
                            <p class="mt-2 text-xs text-slate-500">Menampilkan @p.Oldest.Count tertua dari @p.Total ajuan.</p>
                        }
                    }
                </ChildContent>
            </Widget>
        </div>

        <Widget T="IReadOnlyList<DailyChanges>" Title="Perubahan 14 hari" Subtitle="Yang sudah disetujui, per hari" Load="LoadChanges">
            <ChildContent Context="days">
                <ColumnChart Series="ChangeSeries" Columns="@ChangeColumns(days)" AriaLabel="Perubahan yang disetujui per hari, 14 hari terakhir" />
            </ChildContent>
        </Widget>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
        <Widget T="IReadOnlyList<AppliedChange>" Title="Aktivitas terbaru" Subtitle="Perubahan yang terakhir disetujui" Load="LoadRecent">
            <ChildContent Context="recent">
                @if (recent.Count == 0)
                {
                    <p class="py-6 text-center text-sm text-slate-500">Belum ada perubahan.</p>
                }
                else
                {
                    <ol class="ml-1 space-y-4 border-l-2 border-slate-200 pl-4">
                        @foreach (var change in recent)
                        {
                            <li class="relative">
                                <span class="absolute -left-[1.4rem] top-1.5 size-2.5 rounded-full bg-sky-500 ring-4 ring-white"></span>
                                <div class="text-sm"><b class="font-semibold text-slate-800">@StatusText(change)</b> <span class="text-slate-500">· @ChangeKinds.Label(change.Kind)</span></div>
                                <div class="text-xs text-slate-500">@change.TableName · diajukan @change.CreatedBy, disetujui @change.ApprovedBy · @(change.ApprovedDate?.ToString("d MMM yyyy HH:mm", Indonesian))</div>
                            </li>
                        }
                    </ol>
                }
            </ChildContent>
        </Widget>

        <Widget T="IReadOnlyList<DailyLogins>" Title="Login 14 hari" Subtitle="Jumlah login ke aplikasi per hari" Load="LoadLogins">
            <ChildContent Context="logins">
                <ColumnChart Series="LoginSeries" Columns="@LoginColumns(logins)" Height="140" AriaLabel="Jumlah login per hari, 14 hari terakhir" />
            </ChildContent>
        </Widget>
    </div>

    <div>
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Pintasan</h2>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            @foreach (var (label, icon, open) in Shortcuts)
            {
                <button type="button" @onclick="open" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 text-left text-sm font-medium text-slate-700 shadow-card transition hover:border-sky-300 hover:bg-sky-50">
                    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-sky-50 text-sky-600"><Icon Name="@icon" /></span>@label
                </button>
            }
        </div>
    </div>
</section>

@code {
    private static readonly CultureInfo Indonesian = CultureInfo.GetCultureInfo("id-ID");

    private static readonly IReadOnlyList<ChartSeries> ChangeSeries =
    [
        new("User", "#2f6fdc"),
        new("Group", "#14b8a6"),
        new("Parameter", "#f59e0b"),
    ];

    private static readonly IReadOnlyList<ChartSeries> LoginSeries = [new("Login", "#2f6fdc")];

    private readonly CancellationTokenSource _cts = new();
    private Task<PendingSummary>? _pending;
    private Task<UserCounts>? _users;
    private string _userId = string.Empty;
    private string _name = string.Empty;

    [CascadingParameter] private IModuleNavigator? Navigator { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private DateTime Now => DateTime.Now;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var part = hour < 11 ? "pagi" : hour < 15 ? "siang" : hour < 18 ? "sore" : "malam";
            return string.IsNullOrEmpty(_name) ? "Dashboard Maintenance" : $"Selamat {part}, {_name}";
        }
    }

    private IReadOnlyList<(string Label, string Icon, Func<Task> Open)> Shortcuts => new (string, string, Func<Task>)[]
    {
        ("Maker user", "users", () => Open<UserMaker>()),
        ("Approval user", "shield", () => Open<UserApproval>()),
        ("Maker group", "building", () => Open<GroupMaker>()),
        ("Approval group", "check-circle", () => Open<GroupApproval>()),
        ("Parameter umum", "cog", () => Open<ParameterSetGenMaker>()),
        ("Persetujuan parameter umum", "check-circle", () => Open<ParameterSetGenApproval>()),
        ("Parameter proses", "rules", () => Open<ParameterSetProcMaker>()),
        ("Persetujuan parameter proses", "check-circle", () => Open<ParameterSetProcApproval>()),
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User.ToSessionUser();
        _userId = user?.UserId ?? string.Empty;
        _name = user?.FullName ?? string.Empty;
        _pending = Dashboard.GetPendingAsync(_userId, 8, _cts.Token);
        _users = Dashboard.GetUserCountsAsync(_cts.Token);
        // Hero dan kartu ikut tampil begitu datanya siap, tanpa menahan widget lain; galat dicatat di sini dan ditampilkan widget.
        _ = Track(_pending);
        _ = Track(_users);
    }

    private Task<PendingSummary> LoadPending(CancellationToken ct) => _pending ?? Dashboard.GetPendingAsync(_userId, 8, ct);

    private Task<IReadOnlyList<DailyChanges>> LoadChanges(CancellationToken ct) => Dashboard.GetChangesAsync(Today, 14, ct);

    private Task<IReadOnlyList<AppliedChange>> LoadRecent(CancellationToken ct) => Dashboard.GetRecentAsync(6, ct);

    private Task<IReadOnlyList<DailyLogins>> LoadLogins(CancellationToken ct) => Dashboard.GetLoginsAsync(Today, 14, ct);

    private async Task Track(Task task)
    {
        try
        {
            await task;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Data ringkasan dashboard Maintenance gagal dimuat");
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task Open<TPage>() where TPage : IComponent
    {
        Navigator?.Open<TPage>();
        return Task.CompletedTask;
    }

    private void Review(ChangeKind kind)
    {
        switch (kind)
        {
            case ChangeKind.User:
                Navigator?.Open<UserApproval>();
                break;
            case ChangeKind.Group:
                Navigator?.Open<GroupApproval>();
                break;
            default:
                Navigator?.Open<ParameterSetGenApproval>();
                break;
        }
    }

    private static string Number(int value) => value.ToString("N0", Indonesian);

    private string Describe(PendingChange item) => $"{item.Status} {item.TableName}" + (string.Equals(item.CreatedBy, _userId, StringComparison.OrdinalIgnoreCase) ? " (ajuan Anda)" : string.Empty);

    private static string StatusText(AppliedChange change) => change.Status switch
    {
        "Insert" => "Ditambahkan",
        "Update" => "Diubah",
        "Delete" => "Dihapus",
        _ => change.Status ?? "Diproses",
    };

    private string AgeTone(PendingChange item)
    {
        var age = item.CreatedDate is null ? TimeSpan.Zero : Now - item.CreatedDate.Value;
        return age.TotalDays >= 3 ? "bg-rose-50 text-rose-700" : age.TotalDays >= 1 ? "bg-amber-50 text-amber-700" : "bg-slate-100 text-slate-600";
    }

    private static IReadOnlyList<ChartColumn> ChangeColumns(IReadOnlyList<DailyChanges> days) =>
        [.. days.Select((d, i) => new ChartColumn(
            d.Day.Day.ToString(CultureInfo.InvariantCulture),
            [d.Users, d.Groups, d.Parameters],
            $"{d.Day.ToString("d MMM", Indonesian)}: {d.Users} user, {d.Groups} group, {d.Parameters} parameter",
            i == days.Count - 1))];

    private static IReadOnlyList<ChartColumn> LoginColumns(IReadOnlyList<DailyLogins> days) =>
        [.. days.Select((d, i) => new ChartColumn(
            d.Day.Day.ToString(CultureInfo.InvariantCulture),
            [d.Logins],
            $"{d.Day.ToString("d MMM", Indonesian)}: {d.Logins.ToString("N0", Indonesian)} login",
            i == days.Count - 1))];

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
