@implements IAsyncDisposable
@using System.Globalization
@using Panin.Application.Export
@using Panin.Application.Reports
@using Panin.Application.Reports.Pivot
@using Panin.Web.Components.Common
@inject IReportService Reports
@inject IExcelExporter Exporter
@inject IJSRuntime JS
@inject ILogger<ReportRun> Logger

<section class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-semibold text-slate-800">@(_def?.Title ?? ReportTitle)</h1>
        @if (Navigator is { CanGoBack: true })
        {
            <button type="button" @onclick="Navigator.Back" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100">← Kembali</button>
        }
    </div>

    @if (_loading)
    {
        <p class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-500" role="status">Memuat...</p>
    }
    else if (_def is null)
    {
        <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert">@(_error ?? "Report tidak ditemukan atau belum tersedia.")</div>
    }
    else
    {
        @if (_def.Notes is { Count: > 0 })
        {
            <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="note">
                <ul class="list-disc pl-5">
                    @foreach (var note in _def.Notes)
                    {
                        <li>@note</li>
                    }
                </ul>
            </div>
        }

        <form @onsubmit="RunAsync" class="rounded-lg border border-slate-200 bg-white p-4">
            @if (_def.Filters.Count > 0)
            {
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var f in _def.Filters)
                    {
                        <Field Label="@f.Caption">
                            @switch (f.Type)
                            {
                                case ReportFilterType.List:
                                    <select value="@Get(f.Seq)" @onchange="e => ListChangedAsync(f, e.Value?.ToString())" class="@InputClass" aria-label="@f.Caption">
                                        <option value="">- semua -</option>
                                        @foreach (var o in OptionsOf(f))
                                        {
                                            <option value="@o.Value" selected="@(o.Value == Get(f.Seq))">@o.Text</option>
                                        }
                                    </select>
                                    break;
                                case ReportFilterType.Date or ReportFilterType.DateFrom or ReportFilterType.DateTo:
                                    <input type="date" value="@Get(f.Seq)" @onchange="e => Set(f.Seq, e.Value?.ToString())" class="@InputClass" aria-label="@f.Caption" />
                                    break;
                                case ReportFilterType.DateRange:
                                    <div class="flex items-center gap-2">
                                        <input type="date" value="@Get(f.Seq)" @onchange="e => Set(f.Seq, e.Value?.ToString())" class="@InputClass" aria-label="@(f.Caption + " dari")" />
                                        <span class="text-xs text-slate-500">s/d</span>
                                        <input type="date" value="@Get(f.Seq + 1)" @onchange="e => Set(f.Seq + 1, e.Value?.ToString())" class="@InputClass" aria-label="@(f.Caption + " sampai")" />
                                    </div>
                                    break;
                                case ReportFilterType.NumberRange:
                                    <div class="flex items-center gap-2">
                                        <input inputmode="decimal" value="@Get(f.Seq)" @onchange="e => Set(f.Seq, e.Value?.ToString())" class="@InputClass" aria-label="@(f.Caption + " dari")" />
                                        <span class="text-xs text-slate-500">s/d</span>
                                        <input inputmode="decimal" value="@Get(f.Seq + 1)" @onchange="e => Set(f.Seq + 1, e.Value?.ToString())" class="@InputClass" aria-label="@(f.Caption + " sampai")" />
                                    </div>
                                    break;
                                case ReportFilterType.Number:
                                    <input inputmode="decimal" value="@Get(f.Seq)" @onchange="e => Set(f.Seq, e.Value?.ToString())" class="@InputClass" aria-label="@f.Caption" />
                                    break;
                                case ReportFilterType.MonthYear:
                                    @MonthYear(f.Seq, f.Caption)
                                    break;
                                case ReportFilterType.MonthYearRange:
                                    <div class="space-y-2">
                                        @MonthYear(f.Seq, f.Caption + " dari")
                                        @MonthYear(f.Seq + 2, f.Caption + " sampai")
                                    </div>
                                    break;
                                default:
                                    <input value="@Get(f.Seq)" @onchange="e => Set(f.Seq, e.Value?.ToString())" maxlength="100" class="@InputClass" aria-label="@f.Caption" />
                                    break;
                            }
                        </Field>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-slate-600">Report ini tidak memiliki filter.</p>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <button type="submit" disabled="@_busy" class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white enabled:hover:bg-sky-800 disabled:opacity-60">TAMPILKAN</button>
                <button type="button" @onclick="ResetAsync" disabled="@_busy" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 enabled:hover:bg-slate-100 disabled:opacity-60">RESET</button>
            </div>
        </form>

        @if (_errors.Count > 0)
        {
            <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
                <ul class="list-disc pl-5">
                    @foreach (var e in _errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        @if (_busy)
        {
            <p class="text-sm text-slate-500" role="status">Memuat data...</p>
        }
        else if (_pivot is not null)
        {
            @if (_pivot.GroupsTruncated || _pivot.Table.Truncated)
            {
                <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status">
                    Hasil terlalu besar dan dipotong; persempit filter agar pivot lengkap.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_pivot.Subtitle))
            {
                <p class="text-sm font-medium text-slate-700">@_pivot.Subtitle</p>
            }

            <div class="flex justify-end">
                <button type="button" @onclick="ExportAsync" disabled="@_exporting"
                        class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 enabled:hover:bg-slate-100 disabled:opacity-40">
                    @(_exporting ? "Menyiapkan..." : "Ekspor Excel")
                </button>
            </div>

            @if (_pivot.Table.Rows.Count == 0 || _pivot.Table.Columns.Count == 0)
            {
                <p class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-500">Tidak ada data.</p>
            }
            else
            {
                <PivotView Result="_pivot.Table" />
            }

            @if (_pivot.Companion is { Rows.Count: > 0 } companion)
            {
                <table class="mt-3 w-auto border-collapse text-sm">
                    <thead class="bg-slate-100 text-slate-700">
                        <tr>
                            @foreach (var h in companion.Headers)
                            {
                                <th class="border border-slate-200 px-3 py-1.5 text-left font-semibold">@h</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in companion.Rows)
                        {
                            <tr>
                                @foreach (var cell in row)
                                {
                                    <td class="border border-slate-200 bg-white px-3 py-1.5">@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (_result is not null)
        {
            @if (_result.Truncated)
            {
                <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status">
                    Menampilkan @_result.MaxRows.ToString("N0", Id) baris pertama; persempit filter atau gunakan Ekspor Excel (maks. @ReportLimits.ExportRows.ToString("N0", Id) baris).
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_result.Subtitle))
            {
                <p class="text-sm font-medium text-slate-700">@_result.Subtitle</p>
            }

            @if (_totals.Count > 0)
            {
                <dl class="flex flex-wrap gap-x-6 gap-y-1 rounded-md bg-slate-50 px-3 py-2 text-sm" aria-label="Ringkasan">
                    @foreach (var (label, value) in _totals)
                    {
                        <div><dt class="inline text-slate-500">@label: </dt><dd class="inline font-semibold text-slate-800">@value</dd></div>
                    }
                </dl>
            }

            <DataGrid TItem="object?[]" Items="_result.Rows" Columns="_columns" EmptyText="Tidak ada data.">
                <Toolbar>
                    <button type="button" @onclick="ExportAsync" disabled="@(_exporting || _result.Rows.Count == 0)"
                            class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 enabled:hover:bg-slate-100 disabled:opacity-40">
                        @(_exporting ? "Menyiapkan..." : "Ekspor Excel")
                    </button>
                </Toolbar>
            </DataGrid>
        }
    }
</section>

@code {
    private const string InputClass = "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500";
    private static readonly CultureInfo Id = CultureInfo.GetCultureInfo("id-ID");
    private static readonly string[] Months = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];

    private readonly CancellationTokenSource _cts = new();
    private readonly Dictionary<int, IReadOnlyList<ReportOption>> _options = [];
    private ReportDefinition? _def;
    private ReportResult? _result;
    private PivotRunResult? _pivot;
    private IReadOnlyList<GridColumn<object?[]>> _columns = [];
    private IReadOnlyList<(string Label, string Value)> _totals = [];
    private IReadOnlyList<string> _errors = [];
    private string?[] _values = [];
    private string? _error;
    private IJSObjectReference? _module;
    private bool _loading = true, _busy, _exporting;

    [Parameter, EditorRequired] public string ReportId { get; set; } = string.Empty;

    [Parameter] public string? ReportTitle { get; set; }

    [CascadingParameter(Name = "ModuleId")] private string ModuleId { get; set; } = "60";

    [CascadingParameter] private Panin.Web.Shell.IModuleNavigator? Navigator { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _def = await Reports.GetAsync(ModuleId, ReportId, _cts.Token);
            if (_def is not null)
            {
                InitValues();
                await LoadOptionsAsync(_def.Filters.Where(f => f.Type == ReportFilterType.List));
            }
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report {ReportId} gagal dimuat", ReportId);
            _error = $"Report gagal dimuat. Coba lagi atau hubungi administrator. {ErrorReference.Tag}";
            _def = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment MonthYear(int seq, string caption) => @<div class="flex items-center gap-2">
        <select value="@Get(seq)" @onchange="e => Set(seq, e.Value?.ToString())" class="@InputClass" aria-label="@(caption + " bulan")">
            <option value="">- bulan -</option>
            @for (var m = 1; m <= 12; m++)
            {
                var value = m.ToString(CultureInfo.InvariantCulture);
                <option value="@value" selected="@(value == Get(seq))">@Months[m - 1]</option>
            }
        </select>
        <input inputmode="numeric" maxlength="4" value="@Get(seq + 1)" @onchange="e => Set(seq + 1, e.Value?.ToString())" class="w-24 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" aria-label="@(caption + " tahun")" />
    </div>;

    private void InitValues()
    {
        _values = new string?[_def!.ParamCount];
        foreach (var f in _def.Filters)
        {
            // Rentang: awal di parameter pertama, akhir di kedua. "Sampai tanggal" memakai nilai akhir; tanggal tunggal dan "dari tanggal" memakai nilai awal.
            if (f.Type == ReportFilterType.DateTo)
            {
                _values[f.Seq - 1] = f.DefaultTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            }
            else if (f.Type is ReportFilterType.Date or ReportFilterType.DateFrom or ReportFilterType.DateRange)
            {
                _values[f.Seq - 1] = f.DefaultFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                if (f.Type == ReportFilterType.DateRange)
                {
                    _values[f.Seq] = f.DefaultTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                }
            }
        }
    }

    private string? Get(int seq) => seq - 1 < _values.Length ? _values[seq - 1] : null;

    private void Set(int seq, string? value)
    {
        if (seq - 1 < _values.Length)
        {
            _values[seq - 1] = string.IsNullOrWhiteSpace(value) ? null : value;
        }
    }

    private IReadOnlyList<ReportOption> OptionsOf(ReportFilter f) => _options.TryGetValue(f.Seq, out var o) ? o : [];

    private async Task ListChangedAsync(ReportFilter changed, string? value)
    {
        Set(changed.Seq, value);

        // Filter yang pilihannya bergantung pada filter ini (dan turunannya) dikosongkan lalu dimuat ulang.
        var stale = new List<ReportFilter>();
        var positions = new HashSet<int> { changed.Seq };
        foreach (var f in _def!.Filters.Where(x => x.Type == ReportFilterType.List && x.Seq > changed.Seq))
        {
            if (f.OptionDependsOn.Any(positions.Contains))
            {
                stale.Add(f);
                Set(f.Seq, null);
                positions.Add(f.Seq);
            }
        }

        try
        {
            await LoadOptionsAsync(stale);
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Pilihan filter report {ReportId} gagal dimuat", ReportId);
            _errors = [$"Pilihan filter gagal dimuat. {ErrorReference.Tag}"];
        }
    }

    private async Task LoadOptionsAsync(IEnumerable<ReportFilter> filters)
    {
        var list = filters.ToList();
        var snapshot = (object?[])_values.Clone();
        var loaded = await Task.WhenAll(list.Select(async f => (f.Seq, Options: await Reports.GetOptionsAsync(ModuleId, _def!, f, snapshot, _cts.Token))));
        foreach (var (seq, options) in loaded)
        {
            _options[seq] = options;
        }
    }

    private async Task ResetAsync()
    {
        InitValues();
        _result = null;
        _pivot = null;
        _errors = [];
        try
        {
            await LoadOptionsAsync(_def!.Filters.Where(f => f.Type == ReportFilterType.List));
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
    }

    private async Task RunAsync()
    {
        if (_busy || _def is null)
        {
            return;
        }

        var (_, errors) = Panin.Application.Reports.ReportSqlBuilder.Coerce(_def, [.. _values]);
        _errors = errors;
        if (errors.Count > 0)
        {
            return;
        }

        _busy = true;
        try
        {
            if (_def.IsPivot)
            {
                _result = null;
                _pivot = await Reports.RunPivotAsync(ModuleId, _def, [.. _values], _cts.Token);
            }
            else
            {
                _pivot = null;
                _result = await Reports.RunAsync(ModuleId, _def, [.. _values], forExport: false, _cts.Token);
                Present(_result);
            }
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report {ReportId} gagal dijalankan", ReportId);
            _result = null;
            _pivot = null;
            _errors = [$"Report gagal dijalankan. Persempit filter atau coba lagi; jika berulang hubungi administrator. {ErrorReference.Tag}"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void Present(ReportResult result)
    {
        _columns = [.. result.Columns.Select((c, i) => new GridColumn<object?[]>
        {
            Header = c.Caption,
            Value = row => row[i],
            Display = row => Format(row[i], c.Kind),
            Numeric = c.Kind is ReportCellKind.Integer or ReportCellKind.Decimal,
            ExportFormat = c.Kind switch { ReportCellKind.Integer => ExportFormat.Count, ReportCellKind.Decimal => ExportFormat.Amount, ReportCellKind.Date => ExportFormat.Date, _ => ExportFormat.Text },
        })];

        var totals = new List<(string, string)>();
        for (var i = 0; i < result.Columns.Count; i++)
        {
            var c = result.Columns[i];
            if (c.Summary == ReportSummary.None)
            {
                continue;
            }

            var values = result.Rows.Select(r => r[i]).Where(v => v is not null).ToList();
            var numbers = values.Select(v => v is IConvertible conv && v is not string and not DateTime ? (decimal?)conv.ToDecimal(CultureInfo.InvariantCulture) : null).Where(n => n.HasValue).Select(n => n!.Value).ToList();
            var text = c.Summary switch
            {
                ReportSummary.Count => values.Count.ToString("N0", Id),
                ReportSummary.Sum when numbers.Count > 0 => numbers.Sum().ToString("N2", Id),
                ReportSummary.Average when numbers.Count > 0 => numbers.Average().ToString("N2", Id),
                ReportSummary.Min when numbers.Count > 0 => numbers.Min().ToString("N2", Id),
                ReportSummary.Max when numbers.Count > 0 => numbers.Max().ToString("N2", Id),
                _ => "-",
            };
            totals.Add(($"{c.Summary} {c.Caption}", text));
        }

        _totals = totals;
    }

    private static string? Format(object? value, ReportCellKind kind) => value switch
    {
        null => null,
        DateTime d => d.TimeOfDay == TimeSpan.Zero ? d.ToString("dd-MMM-yyyy", Id) : d.ToString("dd-MMM-yyyy HH:mm", Id),
        decimal or double or float when kind == ReportCellKind.Decimal => string.Format(Id, "{0:N2}", value),
        int or long or short or byte => string.Format(Id, "{0:N0}", value),
        _ => Convert.ToString(value, Id),
    };

    private async Task ExportAsync()
    {
        if (_exporting || _def is null || (_result is null && _pivot is null))
        {
            return;
        }

        _exporting = true;
        try
        {
            ExportTable table;
            if (_pivot is not null)
            {
                table = PivotLayoutView.ToExportTable(_pivot.Table, _def.Title);
            }
            else
            {
                // Hasil layar dipotong di batas tampilan; ekspor mengambil ulang sampai batas ekspor.
                var full = _result!.Truncated ? await Reports.RunAsync(ModuleId, _def, [.. _values], forExport: true, _cts.Token) : _result;
                table = new ExportTable(
                    _def.Title.Length > 31 ? _def.Title[..31] : _def.Title,
                    [.. full.Columns.Select(c => new ExportColumn(c.Caption, c.Kind switch { ReportCellKind.Integer => ExportFormat.Count, ReportCellKind.Decimal => ExportFormat.Amount, ReportCellKind.Date => ExportFormat.Date, _ => ExportFormat.Text }))],
                    [.. full.Rows.Select(r => (IReadOnlyList<object?>)r)]);
            }

            var bytes = Exporter.Export(table);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await _module.InvokeVoidAsync("downloadFromStream", $"report-{ReportId}-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx", IExcelExporter.ContentType, reference);
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ekspor report {ReportId} gagal", ReportId);
            _errors = [$"Ekspor gagal. Coba lagi atau hubungi administrator. {ErrorReference.Tag}"];
        }
        finally
        {
            _exporting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // sirkuit sudah putus
            }
        }
    }
}
