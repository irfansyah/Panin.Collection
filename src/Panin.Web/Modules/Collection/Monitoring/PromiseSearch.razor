@attribute [ModulePage("60", "/collection/monitoring/janji")]
@implements IDisposable
@using System.Globalization
@using Panin.Application.Collection
@using Panin.Application.Export
@using Panin.Web.Components.Common
@using Panin.Web.Modules.Collection.Inquiry
@inject IPromiseService Promises
@inject ILogger<PromiseSearch> Logger

<section class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-semibold text-slate-800">Janji Debitur</h1>
        @if (Navigator is { CanGoBack: true })
        {
            <button type="button" @onclick="Navigator.Back" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100">← Kembali</button>
        }
    </div>

    <p class="rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
        Janji bayar dari call dan visit milik Anda dan seluruh bawahan, menurut tanggal janji. Rentang maksimal @PromiseRules.MaxRangeDays hari.
    </p>

    <form @onsubmit="SearchAsync" class="rounded-lg border border-slate-200 bg-white p-4">
        <div class="grid gap-4 sm:grid-cols-3">
            <Field Label="Hasil / Janji">
                <Select Items="_results" @bind-Value="_resultId" />
            </Field>
            <Field Label="Tanggal awal" Required="true">
                <input id="from" type="date" value="@_from" @onchange="e => _from = e.Value?.ToString()" class="@InputClass" />
            </Field>
            <Field Label="Tanggal akhir" Required="true">
                <input id="to" type="date" value="@_to" @onchange="e => _to = e.Value?.ToString()" class="@InputClass" />
            </Field>
        </div>
        <div class="mt-3 flex gap-2">
            <button type="submit" disabled="@_busy" class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white enabled:hover:bg-sky-800 disabled:opacity-60">CARI</button>
        </div>
    </form>

    @if (_errors.Count > 0)
    {
        <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
            <ul class="list-disc pl-5">
                @foreach (var e in _errors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }

    @if (_busy)
    {
        <p class="text-sm text-slate-500" role="status">Memuat...</p>
    }
    else if (_result is not null)
    {
        @if (_result.Truncated)
        {
            <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status">
                Menampilkan @_result.MaxRows.ToString("N0", Id) janji pertama; persempit tanggal atau jenis hasil.
            </div>
        }

        <DataGrid @ref="_grid" TItem="PromiseRow" Items="_result.Rows" Columns="_columns" EmptyText="Tidak ada janji pada rentang ini.">
            <Toolbar>
                <ExportButton Source="BuildExport" FileName="janji-debitur" Disabled="@(_result.Rows.Count == 0)" />
            </Toolbar>
        </DataGrid>
    }
</section>

@code {
    private const string InputClass = "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500";
    private static readonly CultureInfo Id = CultureInfo.GetCultureInfo("id-ID");

    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<LookupItem> _results = [];
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<GridColumn<PromiseRow>> _columns = [];
    private PromiseSearchResult? _result;
    private DataGrid<PromiseRow>? _grid;
    private string? _userId, _resultId, _from, _to;
    private bool _busy;

    [CascadingParameter] private Panin.Web.Shell.IModuleNavigator? Navigator { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _from = _to = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _columns =
        [
            new() { Header = "Aktivitas", Value = r => r.Activity },
            new() { Header = "Tgl Janji", Value = r => r.PromiseDate, Display = r => r.PromiseDate?.ToString("dd-MMM-yyyy", Id), ExportFormat = ExportFormat.Date },
            new() { Header = "Waktu", Value = r => r.PromiseTime },
            new() { Header = "Janji Debitur", Value = r => r.Result },
            new() { Header = "No Rek", Value = r => r.AccountNo },
            new() { Header = "Nama", Value = r => r.CustomerName },
            new() { Header = "Produk", Value = r => r.Facility },
            new() { Header = "DPD", Value = r => r.Dpd, Numeric = true, ExportFormat = ExportFormat.Count },
            new() { Header = "Kol", Value = r => r.Collectibility },
            new() { Header = "Aktivitas Terakhir", Value = r => r.LastAction },
            new() { Header = "Officer", Value = r => r.Officer },
            new() { Header = "Aksi", Value = r => r.AccountNo, ActionOnly = true, Sortable = false, Template = r => @<button type="button" @onclick="() => OpenDetail(r)" class="rounded border border-sky-300 px-2 py-0.5 text-xs font-medium text-sky-800 hover:bg-sky-50">Detail</button> },
        ];

        try
        {
            _userId = (await AuthState).User.ToSessionUser()?.UserId;
            _results = await Promises.GetResultsAsync(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Daftar hasil janji gagal dimuat");
            _errors = [$"Daftar hasil gagal dimuat. {ErrorReference.Tag}"];
        }
    }

    private async Task SearchAsync()
    {
        if (_busy || _userId is null)
        {
            return;
        }

        if (!DateTime.TryParse(_from, CultureInfo.InvariantCulture, DateTimeStyles.None, out var from) || !DateTime.TryParse(_to, CultureInfo.InvariantCulture, DateTimeStyles.None, out var to))
        {
            _errors = ["Tanggal awal dan akhir wajib diisi dengan benar."];
            return;
        }

        _busy = true;
        _errors = [];
        try
        {
            var result = await Promises.SearchAsync(_userId, _resultId, from, to, _cts.Token);
            _errors = result.Errors;
            _result = result.Success ? result : null;
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Pencarian janji debitur gagal");
            _result = null;
            _errors = [$"Pencarian gagal. Persempit rentang tanggal atau coba lagi; jika berulang hubungi administrator. {ErrorReference.Tag}"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenDetail(PromiseRow row)
        => Navigator?.Open<DebiturDetail>(new Dictionary<string, object?> { [nameof(DebiturDetail.AccountNo)] = row.AccountNo });

    private ExportTable BuildExport() => _grid!.ToExportTable("Janji Debitur");

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
