@attribute [ModulePage("60", "/collection/debitur/letter")]
@implements IDisposable
@using System.Globalization
@using Panin.Application.Collection
@using Panin.Web.Components.Common
@inject ILetterService Letters
@inject ILogger<LetterForm> Logger

<section class="space-y-4">
    <div class="flex items-center justify-between gap-3">
        <h1 class="text-xl font-semibold text-slate-800">Letter <span class="text-base font-normal text-slate-500">· @AccountNo</span></h1>
        @if (Navigator is { CanGoBack: true })
        {
            <button type="button" @onclick="Navigator.Back" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100">← Kembali</button>
        }
    </div>

    @if (_loading)
    {
        <p class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-500" role="status">Memuat form...</p>
    }
    else if (_denied)
    {
        <div class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert">
            Anda tidak berwenang mencatat aktivitas pada rekening ini. Hanya pemilik rekening dan atasannya yang dapat melakukannya.
        </div>
    }
    else
    {
        @if (_saved)
        {
            <div class="rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700" role="status">
                @(_pending ? "Jenis surat ini sudah diminta dan belum diterbitkan; catatan Anda disimpan sebagai memo." : "Permintaan surat tersimpan.")
            </div>
        }

        @if (_errors.Count > 0)
        {
            <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
                <ul class="list-disc pl-5">
                    @foreach (var e in _errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="_entry" OnSubmit="SaveAsync" class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="grid gap-4 sm:grid-cols-2">
                <Field Label="Jenis Surat" Required>
                    <Select Items="_types" @bind-Value="_entry.TypeCode" />
                </Field>
            </div>
            <div class="mt-4">
                <label for="notes" class="mb-1 block text-sm font-medium text-slate-700">Catatan <span class="text-red-600" aria-hidden="true">*</span></label>
                <InputTextArea id="notes" @bind-Value="_entry.Notes" rows="4" maxlength="@LetterRules.MaxNotesLength"
                               class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
            </div>
            <div class="mt-4">
                <button type="submit" disabled="@_busy"
                        class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white enabled:hover:bg-sky-800 disabled:opacity-60">
                    @(_busy ? "Menyimpan..." : "Simpan")
                </button>
            </div>
        </EditForm>

        <Card Title="Riwayat Permintaan Surat">
            <DataGrid TItem="LetterHistoryRow" Items="_history" Columns="_historyColumns" EmptyText="Belum ada permintaan surat." />
        </Card>
    }
</section>

@code {
    private static readonly CultureInfo Id = CultureInfo.GetCultureInfo("id-ID");

    private readonly CancellationTokenSource _cts = new();
    private readonly IReadOnlyList<GridColumn<LetterHistoryRow>> _historyColumns =
    [
        new() { Header = "Tanggal", Value = r => r.RequestedAt, Display = r => r.RequestedAt?.ToString("dd-MMM-yyyy HH:mm", Id) },
        new() { Header = "Jenis Surat", Value = r => r.TypeName ?? r.TypeCode },
        new() { Header = "Oleh", Value = r => r.RequestedBy },
        new() { Header = "No. Surat", Value = r => r.LetterNo },
        new() { Header = "Catatan", Value = r => r.Notes },
    ];

    private LetterEntry _entry = new();
    private IReadOnlyList<LookupItem> _types = [];
    private IReadOnlyList<LetterHistoryRow> _history = [];
    private IReadOnlyList<string> _errors = [];
    private string? _userId, _loadedFor;
    private bool _loading = true, _denied, _busy, _saved, _pending;

    [Parameter] public string AccountNo { get; set; } = string.Empty;

    [Parameter] public string? CustomerRef { get; set; }

    [CascadingParameter] private IModuleNavigator? Navigator { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == AccountNo)
        {
            return;
        }

        _loadedFor = AccountNo;
        _loading = true;
        _entry.AccountNo = AccountNo;
        try
        {
            _userId = (await AuthState).User.ToSessionUser()?.UserId;
            if (_userId is null || !await Letters.CanActAsync(_userId, AccountNo, _cts.Token))
            {
                _denied = true;
                return;
            }

            var types = Letters.GetTypesAsync(AccountNo, _cts.Token);
            var history = Letters.GetHistoryAsync(AccountNo, 30, _cts.Token);
            await Task.WhenAll(types, history);
            _types = types.Result;
            _history = history.Result;
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gagal memuat form surat");
            _errors = ["Form gagal dimuat. Coba lagi atau hubungi administrator."];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_busy || _userId is null)
        {
            return;
        }

        _busy = true;
        _saved = false;
        try
        {
            var result = await Letters.SaveAsync(_userId, _entry, _cts.Token);
            _errors = result.Errors;
            if (result.Success)
            {
                _saved = true;
                _pending = result.AlreadyPending;
                _entry = new LetterEntry { AccountNo = AccountNo };
                _history = await Letters.GetHistoryAsync(AccountNo, 30, _cts.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // halaman ditutup
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Simpan surat gagal");
            _errors = ["Data gagal disimpan. Coba lagi atau hubungi administrator."];
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
