@page "/Error"
@using Panin.Application.Diagnostics

<PageTitle>Terjadi kesalahan</PageTitle>

<main class="mx-auto mt-16 max-w-lg rounded-lg border border-red-200 bg-white p-6 shadow-sm">
    <h1 class="text-xl font-semibold text-red-700">Terjadi kesalahan</h1>
    <p class="mt-2 text-sm text-slate-700">
        Permintaan Anda tidak dapat diproses. Kesalahan ini sudah tercatat.
        Sebutkan kode berikut bila menghubungi administrator:
    </p>
    <p class="mt-3"><code class="rounded bg-slate-100 px-2 py-1 font-mono text-slate-900">@_reference</code></p>
    <p class="mt-4 text-sm"><a href="/" class="text-sky-700 underline">Kembali ke beranda</a></p>
</main>

@code {
    private string _reference = string.Empty;

    // Kode sama dengan awal TraceId di baris log yang mencatat galatnya (properti Ref).
    protected override void OnInitialized() => _reference = ErrorReference.Current.ToUpperInvariant();
}
