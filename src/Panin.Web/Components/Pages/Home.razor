@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Panin.Application.Status
@using Panin.Web.Components.Shell
@inject IModuleRegistry Modules
@inject IMenuService Menus
@inject ModulePageCatalog Pages
@inject WorkspaceState State
@inject IDataStatusService DataStatus
@inject IWarningService Warnings
@inject ILogger<Home> Logger

<PageTitle>Panin Collection</PageTitle>

@if (User is null)
{
    return;
}

<div class="flex h-dvh bg-slate-100 text-slate-800">
    @if (_modules.Count > 0)
    {
        <aside class="@(_menuOpen ? "translate-x-0" : "-translate-x-full") side fixed inset-y-0 left-0 z-40 w-64 lg:relative lg:z-30 lg:shrink-0 lg:translate-x-0" aria-label="Menu samping">
            <div class="side-panel flex h-full w-full flex-col bg-sky-950 text-slate-300">
                <div class="flex h-16 shrink-0 items-center gap-3 px-4">
                    <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-sky-500 text-sm font-bold text-white" aria-hidden="true">P</span>
                    <div class="brand-text leading-tight">
                        <div class="whitespace-nowrap text-sm font-semibold text-white">Panin Collection</div>
                        <div class="whitespace-nowrap text-xs text-slate-400">@ActiveModuleName</div>
                    </div>
                </div>
                <nav class="scroll-thin min-h-0 flex-1 overflow-y-auto overflow-x-hidden px-3 pb-4" aria-label="Menu">
                    @foreach (var ws in State.Opened)
                    {
                        <div @key="ws.Module.Id" class="@(ws.Module.Id == State.ActiveModuleId ? "" : "hidden")">
                            <MenuTree Nodes="ws.Menu" Workspace="ws" OnSelect="node => SelectAsync(ws, node)" />
                        </div>
                    }
                </nav>
            </div>
        </aside>
        @if (_menuOpen)
        {
            <div class="fixed inset-0 z-30 bg-slate-900/50 lg:hidden" @onclick="() => _menuOpen = false" aria-hidden="true"></div>
        }
    }

    <div class="flex min-w-0 flex-1 flex-col">
        <header class="relative z-20 flex h-16 shrink-0 items-center gap-3 border-b border-slate-200 bg-white px-3 sm:px-5">
            @if (_modules.Count > 0)
            {
                <button type="button" @onclick="() => _menuOpen = !_menuOpen" aria-label="Buka menu" aria-expanded="@(_menuOpen ? "true" : "false")"
                        class="rounded-lg border border-slate-200 p-2 text-slate-600 hover:bg-slate-50 lg:hidden">
                    <Icon Name="queue" />
                </button>
                <button type="button" data-side-toggle aria-label="Sembunyikan menu samping" title="Sembunyikan menu samping (Ctrl+B)" aria-expanded="true"
                        class="hidden rounded-lg border border-slate-200 p-2 text-slate-600 hover:bg-slate-50 lg:inline-flex">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="3" x2="9" y2="21" /></svg>
                </button>
            }
            <div class="min-w-0 flex-1"></div>
            @if (_freshness is { IsStale: true })
            {
                <span class="hidden items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 sm:inline-flex" title="Tanggal update data terakhir @_freshness.LastUpdate.ToString("d MMMM yyyy", Indonesian)">
                    <span class="size-2 rounded-full bg-amber-500"></span>Data per @_freshness.LastUpdate.ToString("d MMM yyyy", Indonesian)
                </span>
            }
            @if (_warnings.HasRows)
            {
                <button type="button" @onclick="() => _showWarnings = true" title="Peringatan"
                        class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700 hover:bg-red-100">
                    <Icon Name="bell" Class="size-4 shrink-0" />Peringatan (@_warnings.Rows.Count)
                </button>
            }
            <span class="hidden text-xs text-slate-500 xl:block">@_now</span>
            <div class="flex items-center gap-2.5" title="@User.FullName ( @User.GroupName - @User.UserId )">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sky-600 text-sm font-semibold text-white" aria-hidden="true">@Initials(User.FullName)</span>
                <div class="hidden leading-tight md:block">
                    <div class="text-sm font-medium text-slate-900">@User.FullName</div>
                    <div class="text-xs text-slate-500">@User.GroupName · @User.UserId</div>
                </div>
            </div>
            <form method="post" action="/auth/logout" id="logout-form">
                <AntiforgeryToken />
                <button type="submit" aria-label="Logout" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    <Icon Name="logout" Class="size-4 shrink-0" /><span class="hidden sm:inline">Logout</span>
                </button>
            </form>
        </header>

        @if (_modules.Count == 0)
        {
            <div class="m-6 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800" role="alert">
                Menu Access Not Yet Defined For This User.
            </div>
        }
        else
        {
            @if (_modules.Count > 1)
            {
                <nav class="scroll-thin flex shrink-0 gap-1 overflow-x-auto border-b border-slate-200 bg-white px-2 sm:px-3" aria-label="Modul">
                    @foreach (var m in _modules)
                    {
                        var active = m.Id == State.ActiveModuleId;
                        <button type="button" @key="m.Id" @onclick="() => ActivateAsync(m)" aria-current="@(active ? "page" : null)"
                                class="@(active ? "border-sky-600 text-sky-800" : "border-transparent text-slate-500 hover:text-slate-900") -mb-px shrink-0 whitespace-nowrap border-b-2 px-4 py-3 text-sm font-medium transition-colors">
                            @m.Name
                        </button>
                    }
                </nav>
            }

            <main class="scroll-thin min-h-0 min-w-0 flex-1 overflow-auto p-3 sm:p-5">
                @foreach (var ws in State.Opened)
                {
                    <div @key="ws.Module.Id" class="@(ws.Module.Id == State.ActiveModuleId ? "" : "hidden")">
                        @foreach (var entry in ws.Pages)
                        {
                            <div @key="entry" class="@(entry == ws.Current ? "" : "hidden")">
                                @if (entry.PageType is not null)
                                {
                                    <CascadingValue Value="ws.Navigator" IsFixed="true">
                                        <CascadingValue Name="ModuleId" Value="ws.Module.Id" IsFixed="true">
                                            <PaninErrorBoundary>
                                                <DynamicComponent Type="entry.PageType" Parameters="entry.Parameters" />
                                            </PaninErrorBoundary>
                                        </CascadingValue>
                                    </CascadingValue>
                                }
                            </div>
                        }
                    </div>
                }
            </main>
        }
    </div>
</div>

<SessionKeeper User="User" />

@if (_showWarnings)
{
    <WarningDialog Warnings="_warnings" OnClose="() => _showWarnings = false" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private SessionUser? User { get; set; }

    private IReadOnlyList<AccessibleModule> _modules = [];
    private string _now = string.Empty;
    private DataFreshness? _freshness;
    private WarningSet _warnings = WarningSet.Empty;
    private bool _showWarnings;
    private bool _menuOpen;

    private string ActiveModuleName => _modules.FirstOrDefault(m => m.Id == State.ActiveModuleId)?.Name ?? string.Empty;

    /// <summary>Huruf di lingkaran pengguna: huruf pertama dari dua kata pertama nama.</summary>
    private static string Initials(string? name)
    {
        var words = (name ?? string.Empty).Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 0 ? "?" : string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }
    private int _clockTicks;
    private Timer? _clock;
    private static readonly CultureInfo Indonesian = CultureInfo.GetCultureInfo("id-ID");

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        User = state.User.ToSessionUser();
        if (User is null)
        {
            return;
        }

        State.Changed += OnStateChanged;
        _modules = await Modules.GetAccessibleAsync(User.GroupId);
        UpdateClock();
        _clock = new Timer(_ => _ = InvokeAsync(OnClockTickAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

        if (State.Active is null && _modules.Count > 0)
        {
            await ActivateAsync(_modules[0]);
        }
    }

    private async Task OnClockTickAsync()
    {
        UpdateClock();
        // Peringatan disegarkan tiap ±10 menit (layanan memakai cache 5 menit); kesegaran data memakai cache 10 menit.
        if (++_clockTicks % 20 == 0)
        {
            await LoadStatusAsync();
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Hanya sirkuit interaktif (bukan prarender) yang memuat status; ditunda acak beberapa detik supaya
        // lonjakan login (700 user) tidak menjadi lonjakan query status di DB DATA. Status bersifat sekunder.
        if (firstRender && User is not null)
        {
            await Task.Delay(Random.Shared.Next(1000, 8000));
            await LoadStatusAsync();
        }
    }

    private async Task LoadStatusAsync()
    {
        if (User is null)
        {
            return;
        }

        // Gagal membaca DB DATA tidak boleh mengganggu shell: layanan mengembalikan null/kosong.
        var userId = User.UserId;
        var freshness = await DataStatus.GetFreshnessAsync();
        var warnings = await Warnings.GetAsync(userId);
        await InvokeAsync(() =>
        {
            _freshness = freshness;
            _warnings = warnings;
            StateHasChanged();
        });
    }

    private void UpdateClock() => _now = DateTime.Now.ToString("HH:mm - dddd, d MMMM yyyy", Indonesian);

    private async Task ActivateAsync(AccessibleModule module)
    {
        var created = State.Activate(module);
        if (created is null || User is null)
        {
            return;
        }

        try
        {
            created.Menu = await Menus.GetMenuAsync(module.Id, User.GroupId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Gagal memuat menu modul {Module}", module.Id);
            created.Menu = [];
        }

        created.SetRoot(Pages.Home(module.Id, module.HomeRoute));
        State.Notify();
    }

    private Task SelectAsync(ModuleWorkspace ws, MenuNode node)
    {
        ws.ActiveMenuId = node.Id;
        _menuOpen = false;
        var page = Pages.Resolve(ws.Module.Id, node.Url);
        if (page.PageType is not null)
        {
            ws.SetRoot(page.PageType, page.Parameters is null ? null : new Dictionary<string, object?>(page.Parameters));
        }
        else
        {
            ws.SetRoot(typeof(NotMigrated), new Dictionary<string, object?>
            {
                [nameof(NotMigrated.Title)] = node.Text,
                [nameof(NotMigrated.LegacyUrl)] = page.Route,
            });
        }

        return Task.CompletedTask;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        _clock?.Dispose();
    }
}
