@page "/change-password"
@layout AuthLayout
@using Microsoft.AspNetCore.DataProtection
@using Panin.Application.Auth
@using Panin.Web.Infrastructure
@inject IAuthService Auth
@inject IDataProtectionProvider DataProtection
@inject NavigationManager Navigation

<PageTitle>Ganti Password - Panin Collection</PageTitle>

<h1 class="text-xl font-semibold text-slate-800">Ganti Password</h1>

@if (Ticket is null)
{
    <p class="mt-4 text-sm text-red-700">Permintaan tidak valid atau sudah kedaluwarsa.</p>
    <a href="/login" class="mt-4 inline-block text-sm text-sky-700 hover:underline">Kembali ke login</a>
}
else
{
    <p class="mb-6 text-sm text-slate-500">
        @(Ticket.Mode == "initial" ? "Silakan ganti password login Anda." : "Password sudah kedaluwarsa, silakan ganti password Anda.")
    </p>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">@Message</div>
    }

    <EditForm Model="Model" FormName="change-password" OnSubmit="SubmitAsync" class="space-y-4">
        <input type="hidden" name="t" value="@Token" />
        @if (Ticket.Mode != "initial")
        {
            <div>
                <label for="old" class="mb-1 block text-sm font-medium text-slate-700">Password lama</label>
                <InputText id="old" type="password" @bind-Value="Model.Old" autocomplete="current-password"
                           class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
            </div>
        }
        <div>
            <label for="new" class="mb-1 block text-sm font-medium text-slate-700">Password baru</label>
            <InputText id="new" type="password" @bind-Value="Model.New" autocomplete="new-password"
                       class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
        </div>
        <div>
            <label for="verify" class="mb-1 block text-sm font-medium text-slate-700">Ulangi password baru</label>
            <InputText id="verify" type="password" @bind-Value="Model.Verify" autocomplete="new-password"
                       class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
        </div>
        <button type="submit" class="w-full rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">Simpan</button>
    </EditForm>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "t")] private string? QueryToken { get; set; }

    [SupplyParameterFromForm(Name = "t")] private string? FormToken { get; set; }

    [SupplyParameterFromForm] private ChangeModel Model { get; set; } = new();

    private string? Message { get; set; }

    private string? Token => FormToken ?? QueryToken;

    private PasswordTicket? Ticket { get; set; }

    protected override void OnInitialized()
        => Ticket = Token is null ? null : PasswordTicket.TryRead(DataProtection, Token);

    private async Task SubmitAsync()
    {
        if (Ticket is null)
        {
            return;
        }

        var outcome = await Auth.ChangePasswordAsync(
            Ticket.UserId, Ticket.Mode == "initial" ? null : Model.Old, Model.New, Model.Verify, HttpContext.RequestAborted);

        if (outcome.Result == PasswordChangeResult.Changed)
        {
            Navigation.NavigateTo("/login?changed=1");
            return;
        }

        Message = outcome.Message ?? "Gagal mengubah password.";
        Model = new ChangeModel();
    }

    private sealed class ChangeModel
    {
        public string Old { get; set; } = string.Empty;

        public string New { get; set; } = string.Empty;

        public string Verify { get; set; } = string.Empty;
    }
}
