@using Panin.Web.Shell

@if (Nodes is null)
{
    <p class="p-2 text-xs text-slate-400">Memuat menu...</p>
}
else if (Nodes.Count == 0)
{
    <p class="p-2 text-xs text-slate-500">Menu belum tersedia.</p>
}
else
{
    <ul class="@(Level == 0 ? "space-y-0.5" : "mb-1 ml-4 space-y-0.5 border-l border-slate-200 pl-1.5")">
        @foreach (var node in Nodes)
        {
            <li @key="node.Id">
                @if (node.IsLeaf)
                {
                    var selected = Workspace.ActiveMenuId == node.Id;
                    <button type="button" @onclick="() => Select(node)"
                            class="@(selected ? "bg-sky-50 font-semibold text-sky-800 ring-1 ring-sky-200" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900") block w-full rounded-lg px-2.5 py-2 text-left text-sm transition-colors">
                        @node.Text
                    </button>
                }
                else
                {
                    var open = Workspace.Expanded.Contains(node.Id);
                    <button type="button" @onclick="() => Toggle(node)" aria-expanded="@open"
                            class="flex w-full items-center justify-between rounded-lg px-2.5 py-2 text-left text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-100">
                        <span>@node.Text</span>
                        <svg class="@(open ? "rotate-90" : "") h-4 w-4 text-slate-400 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.2 4.6a1 1 0 0 1 1.4 0l4.7 4.7a1 1 0 0 1 0 1.4l-4.7 4.7a1 1 0 1 1-1.4-1.4L11.2 10 7.2 6a1 1 0 0 1 0-1.4Z" clip-rule="evenodd" /></svg>
                    </button>
                    @if (open)
                    {
                        <MenuTree Nodes="node.Children" Workspace="Workspace" OnSelect="OnSelect" Level="Level + 1" />
                    }
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter] public IReadOnlyList<MenuNode>? Nodes { get; set; }

    [Parameter, EditorRequired] public ModuleWorkspace Workspace { get; set; } = default!;

    [Parameter] public EventCallback<MenuNode> OnSelect { get; set; }

    [Parameter] public int Level { get; set; }

    private void Toggle(MenuNode node)
    {
        if (!Workspace.Expanded.Add(node.Id))
        {
            Workspace.Expanded.Remove(node.Id);
        }
    }

    private Task Select(MenuNode node) => OnSelect.InvokeAsync(node);
}
