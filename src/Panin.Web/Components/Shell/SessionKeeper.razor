@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IAuthService Auth
@inject IOptions<SessionOptions> Options
@inject ILogger<SessionKeeper> Logger
@inject Panin.Web.Infrastructure.Logging.ICircuitContext CircuitContext

@if (_warningSeconds is { } remaining)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4" role="alertdialog" aria-modal="true" aria-labelledby="idle-title">
        <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
            <h2 id="idle-title" class="text-base font-semibold text-red-700">Peringatan</h2>
            <p class="mt-2 text-sm text-slate-700">
                Sesi Anda tidak aktif selama @Options.Value.IdleWarningMinutes menit. Sesi akan ditutup otomatis dalam
                <strong>@(remaining / 60):@((remaining % 60).ToString("00"))</strong> menit bila tidak ada aktivitas.
            </p>
            <button type="button" @onclick="StayAsync" class="mt-4 rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">
                Tetap masuk
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public SessionUser User { get; set; } = default!;

    private IJSObjectReference? _module;
    private Timer? _timer;
    private DateTimeOffset _lastBeat = DateTimeOffset.MinValue;
    private int? _warningSeconds;
    private int _ticking;
    private bool _loggedOut;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/idle.js");
        await _module.InvokeVoidAsync("start");
        _timer = new Timer(_ => _ = InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(15));
    }

    private async Task TickAsync()
    {
        // Cegah tick tumpang tindih bila satu putaran lebih lama dari interval.
        if (_module is null || _loggedOut || Interlocked.Exchange(ref _ticking, 1) == 1)
        {
            return;
        }

        using var activity = Panin.Application.Diagnostics.Telemetry.Begin("session.tick");
        using var scope = Panin.Application.Diagnostics.CorrelationContext.Set(CircuitContext.Info);
        try
        {
            var o = Options.Value;
            var idle = await _module.InvokeAsync<double>("idleSeconds");
            var warnAt = o.IdleWarningMinutes * 60;
            var logoutAt = warnAt + (o.IdleLogoutAfterWarningMinutes * 60);

            if (idle >= logoutAt)
            {
                await LogoutAsync();
                return;
            }

            var next = idle >= warnAt ? (int)Math.Ceiling(logoutAt - idle) : (int?)null;
            if (next != _warningSeconds)
            {
                _warningSeconds = next;
                StateHasChanged();
            }

            if (DateTimeOffset.UtcNow - _lastBeat >= TimeSpan.FromSeconds(o.HeartbeatSeconds))
            {
                _lastBeat = DateTimeOffset.UtcNow;
                if (!await Auth.HeartbeatAsync(User.UserId, User.SessionId, User.Host))
                {
                    await LogoutAsync();
                }
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException and not JSDisconnectedException)
        {
            Logger.LogWarning(ex, "Detak sesi gagal untuk {UserId}", User.UserId);
        }
        finally
        {
            Interlocked.Exchange(ref _ticking, 0);
        }
    }

    private async Task StayAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("reset");
        }

        _warningSeconds = null;
    }

    private async Task LogoutAsync()
    {
        _loggedOut = true;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("logout");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Sirkuit sudah putus; tidak ada yang perlu dibersihkan di klien.
            }
        }
    }
}
