<div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
    <h2 class="text-lg font-semibold text-slate-800">@Title</h2>
    <p class="mt-2 text-sm text-slate-600">Halaman ini belum dimigrasi ke aplikasi baru.</p>
    @if (!string.IsNullOrEmpty(LegacyUrl))
    {
        <p class="mt-3 font-mono text-xs text-slate-400">@LegacyUrl</p>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string? LegacyUrl { get; set; }
}
