<section class="rounded-xl border border-slate-200 bg-white shadow-card">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2 class="border-b border-slate-100 px-4 py-3 text-sm font-semibold text-slate-800">@Title</h2>
    }
    <div class="p-4">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
