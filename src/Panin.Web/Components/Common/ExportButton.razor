@implements IAsyncDisposable
@using Panin.Application.Export
@inject IExcelExporter Exporter
@inject IJSRuntime JS

<button type="button" @onclick="ExportAsync" disabled="@(Disabled || _busy)"
        class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 enabled:hover:bg-slate-100 disabled:opacity-40">
    @(_busy ? "Menyiapkan..." : "Ekspor Excel")
</button>

@code {
    private IJSObjectReference? _module;
    private bool _busy;

    /// <summary>Menghasilkan tabel yang diekspor; dipanggil saat tombol ditekan.</summary>
    [Parameter, EditorRequired] public Func<ExportTable> Source { get; set; } = default!;

    [Parameter] public string FileName { get; set; } = "export";

    [Parameter] public bool Disabled { get; set; }

    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            var bytes = Exporter.Export(Source());
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await _module.InvokeVoidAsync("downloadFromStream", $"{FileName}-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx", IExcelExporter.ContentType, reference);
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // sirkuit sudah putus
            }
        }
    }
}
