@implements IAsyncDisposable
@using Panin.Application.Export
@inject IExcelExporter Exporter
@inject IJSRuntime JS

<ExportMenu Disabled="@Disabled" Busy="@_busy" OnSelect="ExportAsync" />

@code {
    private IJSObjectReference? _module;
    private bool _busy;

    /// <summary>Menghasilkan tabel yang diekspor; dipanggil saat tombol ditekan.</summary>
    [Parameter, EditorRequired] public Func<ExportTable> Source { get; set; } = default!;

    [Parameter] public string FileName { get; set; } = "export";

    [Parameter] public bool Disabled { get; set; }

    private async Task ExportAsync(ExportKind kind)
    {
        _busy = true;
        try
        {
            var table = Source();
            var file = TableExport.Create(table, kind, Exporter);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            using var stream = new MemoryStream(file.Content);
            using var reference = new DotNetStreamReference(stream);
            await _module.InvokeVoidAsync("downloadFromStream", $"{FileName}-{DateTime.Now:yyyyMMdd-HHmmss}.{file.Extension}", file.ContentType, reference);
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // sirkuit sudah putus
            }
        }
    }
}
