@using Panin.Application.Export

<div class="no-print relative inline-block">
    <button type="button" @onclick="() => _open = !_open" disabled="@Disabled" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")"
            class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 enabled:hover:bg-slate-100 disabled:opacity-40">
        @(Busy ? "Menyiapkan..." : "Ekspor ▾")
    </button>
    @if (_open)
    {
        <div class="fixed inset-0 z-20" @onclick="() => _open = false" aria-hidden="true"></div>
        <ul role="menu" class="absolute right-0 z-30 mt-1 w-40 overflow-hidden rounded-lg border border-slate-200 bg-white py-1 text-left shadow-lg">
            @foreach (var kind in Kinds)
            {
                var k = kind;
                <li role="none">
                    <button type="button" role="menuitem" @onclick="() => SelectAsync(k)"
                            class="block w-full px-3 py-1.5 text-left text-xs text-slate-700 hover:bg-sky-50">@TableExport.Label(k)</button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private static readonly ExportKind[] Kinds = [ExportKind.Xlsx, ExportKind.Csv, ExportKind.Pdf, ExportKind.Rtf, ExportKind.Txt];

    private bool _open;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public EventCallback<ExportKind> OnSelect { get; set; }

    private async Task SelectAsync(ExportKind kind)
    {
        _open = false;
        await OnSelect.InvokeAsync(kind);
    }
}
