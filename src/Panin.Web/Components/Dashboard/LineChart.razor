@* Grafik garis dengan area berwarna (SVG). Titik terakhir ditonjolkan. *@
@{
    const double w = 560, h = 190, pad = 28;
    var coords = ChartMath.LineCoordinates([.. Points.Select(p => p.Value)], w, h, pad);
    string F(double v) => ChartMath.Css(v);
    var path = string.Join(' ', coords.Select((c, i) => $"{(i == 0 ? "M" : "L")}{F(c.X)},{F(c.Y)}"));
}
@if (coords.Count > 0)
{
    <svg viewBox="@($"0 0 {w} {h}")" class="w-full" role="img" aria-label="@AriaLabel">
        <defs>
            <linearGradient id="@_id" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#2f6fdc" stop-opacity=".28" />
                <stop offset="1" stop-color="#2f6fdc" stop-opacity="0" />
            </linearGradient>
        </defs>
        <line x1="@F(pad)" x2="@F(w - pad)" y1="@F(h - pad)" y2="@F(h - pad)" stroke="#e2e8f0" />
        <path d="@($"{path} L{F(coords[^1].X)},{F(h - pad)} L{F(coords[0].X)},{F(h - pad)} Z")" fill="@($"url(#{_id})")" />
        <path d="@path" fill="none" stroke="#2f6fdc" stroke-width="2.4" stroke-linejoin="round" />
        @for (var i = 0; i < coords.Count; i++)
        {
            var last = i == coords.Count - 1;
            <circle cx="@F(coords[i].X)" cy="@F(coords[i].Y)" r="@(last ? 5 : 2.5)" fill="@(last ? "#1d5bc4" : "#fff")" stroke="#2f6fdc" stroke-width="2">
                <title>@Points[i].Label: @Points[i].Value.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("id-ID"))@Suffix</title>
            </circle>
            @* Elemen SVG text bentrok dengan tag <text> Razor, jadi ditulis sebagai markup yang sudah di-encode. *@
            @((MarkupString)$"<text x=\"{F(coords[i].X)}\" y=\"{F(h - 6)}\" font-size=\"10\" text-anchor=\"middle\" fill=\"#94a3b8\">{System.Net.WebUtility.HtmlEncode(Points[i].Label)}</text>")
        }
    </svg>
}

@code {
    private readonly string _id = "lc" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired] public IReadOnlyList<LinePoint> Points { get; set; } = [];

    [Parameter] public string Suffix { get; set; } = string.Empty;

    [Parameter] public string AriaLabel { get; set; } = "Grafik garis";
}
