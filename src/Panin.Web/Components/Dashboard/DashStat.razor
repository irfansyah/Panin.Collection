@* Satu angka penting di kartu dengan ubin berikon (warna = keadaan: ok hijau, warn kuning, bad merah, info biru). Bila ada OnClick seluruh kartu menjadi tombol. *@
@if (OnClick.HasDelegate)
{
    <button type="button" @onclick="OnClick" class="@(Frame + " group w-full text-left hover:-translate-y-0.5 hover:shadow-md")">@Inner</button>
}
else
{
    <div class="@Frame">@Inner</div>
}

@code {
    private const string Frame = "relative block rounded-xl border border-slate-200 bg-white p-4 shadow-card transition duration-150";

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string IconName { get; set; } = "chart";

    /// <summary>ok | warn | bad | info</summary>
    [Parameter] public string Tone { get; set; } = "info";

    [Parameter] public EventCallback OnClick { get; set; }

    private string Tile => Tone switch
    {
        "ok" => "bg-emerald-50 text-emerald-600",
        "warn" => "bg-amber-50 text-amber-600",
        "bad" => "bg-rose-50 text-rose-600",
        _ => "bg-sky-50 text-sky-600",
    };

    private RenderFragment Inner => @<text>
        @if (OnClick.HasDelegate)
        {
            <span class="absolute right-4 top-4 text-slate-300 group-hover:text-slate-500" aria-hidden="true"><Icon Name="arrow-up-right" Class="size-4" /></span>
        }
        <span class="@("grid size-10 place-items-center rounded-xl " + Tile)"><Icon Name="@IconName" /></span>
        <div class="mt-3 text-sm font-medium text-slate-700">@Label</div>
        <div class="text-3xl font-semibold tabular-nums leading-tight tracking-tight text-slate-900">@Value</div>
        @if (!string.IsNullOrEmpty(Hint))
        {
            <div class="mt-0.5 text-xs text-slate-500">@Hint</div>
        }
    </text>;
}
